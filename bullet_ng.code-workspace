{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "../../projects/bullet_drone"
		},
		{
			"path": "../../projects/bullet_render"
		},
		{
			"path": "../../projects/bullet_app"
		},
		{
			"path": "../../projects/beta_client"
		},
		{
			"path": "../../projects/bullet_view"
		},
		{
			"path": "../../projects/bullet_perception"
		},
		{
			"path": "../../projects/los_tracking"
		},
		{
			"path": "../../projects/bullet_visual"
		},
		{
			"path": "../../projects/mcap_bagger"
		},
		{
			"path": "../../projects/flight_lens"
		}
	],
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Bullet: Run target-hit mission stack (tmux)",
				"type": "shell",
				"command": "bash launch/run_target_hit.sh",
				"options": { "cwd": "${workspaceFolder:bullet_ng}" },
				"icon": { "id": "play", "color": "terminal.ansiWhite" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
				"detail": "Attach to the four-pane target-hit tmux session; Godot and View share DP-1-0."
			},
			{
				"label": "Bullet: Run hover/land mission stack (tmux)",
				"type": "shell",
				"command": "bash launch/run_hover_land.sh",
				"options": { "cwd": "${workspaceFolder:bullet_ng}" },
				"icon": { "id": "play", "color": "terminal.ansiWhite" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
				"detail": "Attach to the three-pane hover/land tmux session; Godot and View open on their selected monitors."
			},
			{
				"label": "FlightLens: Open",
				"type": "shell",
				"command": "bash launch/run_flight_lens.sh",
				"options": { "cwd": "${workspaceFolder:bullet_ng}" },
				"icon": { "id": "play", "color": "terminal.ansiGreen" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
				"detail": "Open Flight Lens with the current project source to inspect MCAP recordings."
			},
			{
				"label": "Bullet: Run hover/land mission stack",
				"icon": { "id": "play", "color": "terminal.ansiYellow" },
				"dependsOn": [
					"Bullet hover: Scene + SITL + renderer",
					"Bullet hover: App (manual approval)",
					"Bullet: View"
				],
				"dependsOrder": "parallel",
				"problemMatcher": [],
				"detail": "Start the 20 m hover/land system in separate terminals; Arm and Start from View."
			},
			{
				"label": "Bullet hover: Scene + SITL + renderer",
				"type": "shell",
				"command": "uv run --frozen --extra render --extra sitl --extra mavlink launcher --sitl --no-gps --render",
				"options": {
					"cwd": "${workspaceFolder:bullet_drone}",
					"env": { "__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia" }
				},
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Bullet hover: App (manual approval)",
				"type": "shell",
				"command": "bash launch/run_app_after_sitl.sh hover-land",
				"options": { "cwd": "${workspaceFolder:bullet_ng}" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Bullet: Run target mission stack",
				"icon": { "id": "play", "color": "terminal.ansiYellow" },
				"dependsOn": [
					"Bullet target: Scene + SITL + renderer",
					"Bullet target: Visual",
					"Bullet target: App (target-hit)",
					"Bullet: View"
				],
				"dependsOrder": "parallel",
				"problemMatcher": [],
				"detail": "Start the red-truck mission components in four separate terminals. Arm and Start from View."
			},
			{
				"label": "Bullet target: Scene + SITL + renderer",
				"type": "shell",
				"command": "uv run --frozen --extra render --extra sitl --extra mavlink launcher --sitl --no-gps --render --target-scene",
				"options": {
					"cwd": "${workspaceFolder:bullet_drone}",
					"env": { "__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia" }
				},
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Bullet target: Visual",
				"type": "shell",
				"command": "uv run --project ../bullet_visual --locked bullet-visual --config ../bullet_visual/config/zmq.yaml",
				"options": { "cwd": "${workspaceFolder:bullet_drone}" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Bullet target: App (target-hit)",
				"type": "shell",
				"command": "bash launch/run_app_after_sitl.sh target-hit",
				"options": { "cwd": "${workspaceFolder:bullet_ng}" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Bullet: View",
				"type": "shell",
				"command": "uv run --project ../bullet_view --locked bullet-view",
				"options": { "cwd": "${workspaceFolder:bullet_drone}" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Isaac Sim: Run hover/land mission stack",
				"icon": { "id": "play", "color": "terminal.ansiCyan" },
				"dependsOn": [
					"Isaac hover: Scene + SITL + renderer",
					"Bullet hover: App (manual approval)",
					"Bullet: View"
				],
				"dependsOrder": "parallel",
				"problemMatcher": [],
				"detail": "Hover/land with Isaac Sim renderer + PyBullet physics; Arm and Start from View."
			},
			{
				"label": "Isaac hover: Scene + SITL + renderer",
				"type": "shell",
				"command": "uv run --frozen --extra render --extra sitl --extra mavlink launcher --sitl --no-gps --render --renderer-backend isaac --render-config external_render/configs/physics.json",
				"options": {
					"cwd": "${workspaceFolder:bullet_drone}",
					"env": { "__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia" }
				},
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Isaac Sim: Run hover/land headless",
				"icon": { "id": "play", "color": "terminal.ansiCyan" },
				"dependsOn": [
					"Isaac hover headless: Scene + SITL + renderer",
					"Bullet hover: App (manual approval)",
					"Bullet: View"
				],
				"dependsOrder": "parallel",
				"problemMatcher": [],
				"detail": "Hover/land with headless Isaac Sim renderer (no Isaac GUI); Arm and Start from View."
			},
			{
				"label": "Isaac hover headless: Scene + SITL + renderer",
				"type": "shell",
				"command": "uv run --frozen --extra render --extra sitl --extra mavlink launcher --sitl --no-gps --render --renderer-backend isaac --render-config external_render/configs/physics.json --isaac-headless",
				"options": {
					"cwd": "${workspaceFolder:bullet_drone}",
					"env": { "__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia" }
				},
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Isaac Sim: Run target-hit mission stack",
				"icon": { "id": "play", "color": "terminal.ansiCyan" },
				"dependsOn": [
					"Isaac target: Scene + SITL + renderer",
					"Bullet target: Visual",
					"Bullet target: App (target-hit)",
					"Bullet: View"
				],
				"dependsOrder": "parallel",
				"problemMatcher": [],
				"detail": "Target-hit with Isaac Sim renderer + PyBullet physics; Arm and Start from View."
			},
			{
				"label": "Isaac target: Scene + SITL + renderer",
				"type": "shell",
				"command": "uv run --frozen --extra render --extra sitl --extra mavlink launcher --sitl --no-gps --render --renderer-backend isaac --render-config external_render/configs/physics.json --target-scene",
				"options": {
					"cwd": "${workspaceFolder:bullet_drone}",
					"env": { "__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia" }
				},
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true }
			},
			{
				"label": "Isaac Sim: Scene only (no SITL, with GUI)",
				"type": "shell",
				"command": "uv run --frozen --extra render launcher --no-sitl --renderer-backend isaac --render-config external_render/configs/physics.json",
				"options": {
					"cwd": "${workspaceFolder:bullet_drone}",
					"env": { "__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia" }
				},
				"icon": { "id": "eye", "color": "terminal.ansiCyan" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true },
				"detail": "Isaac Sim renderer with PyBullet physics, no SITL or flight control. Useful for scene inspection."
			},
			{
				"label": "Isaac Sim: Scene with USD world",
				"type": "shell",
				"command": "uv run --frozen --extra render launcher --no-sitl --renderer-backend isaac --render-config external_render/configs/physics.json --world ${input:usdWorldPath}",
				"options": {
					"cwd": "${workspaceFolder:bullet_drone}",
					"env": { "__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia" }
				},
				"icon": { "id": "globe", "color": "terminal.ansiCyan" },
				"problemMatcher": [],
				"presentation": { "reveal": "always", "panel": "new", "clear": true },
				"detail": "Isaac Sim renderer with a custom USD world file (no SITL)."
			}
		],
		"inputs": [
			{
				"id": "usdWorldPath",
				"type": "promptString",
				"description": "Path to USD world file (e.g. ~/ov/rivermark.usd)"
			}
		]
	}
}
